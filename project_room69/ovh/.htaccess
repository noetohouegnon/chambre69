# ─────────────────────────────────────────────────────────────────────────────
# Chambre 69 — réglages Apache pour l'hébergement web OVH.
# Copié automatiquement à la racine du site (dossier www) par le robot de mise
# en ligne (.github/workflows/deploy-ovh.yml). Ne pas modifier sur le serveur.
# ─────────────────────────────────────────────────────────────────────────────

Options -Indexes -MultiViews
DirectoryIndex index.html index.php
DirectorySlash Off
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/yaml .yml
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Toujours en HTTPS (certificat SSL gratuit à activer dans l'espace client OVH).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{SERVER_PORT} =80
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 2. Adresse sans « www » (redirige www.chambre69.sn vers chambre69.sn).
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # 3. Fichiers et dossiers cachés interdits (sauf la validation SSL .well-known).
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # 4. Adresses sans barre finale : /mariee/ → /mariee.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # 5. Adresses propres : /mariee → mariee.html.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # 6. Dossier avec page d'accueil : /admin → admin/index.html.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ $1/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # Protection des pages publiques (l'administration en a besoin d'autres).
  <If "%{REQUEST_URI} !~ m#^/admin(/|$)#">
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https:; frame-src https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self' https://wa.me https://api.whatsapp.com; frame-ancestors 'self'; upgrade-insecure-requests"
  </If>
  <If "%{REQUEST_URI} =~ m#^/admin(/|$)#">
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set Cache-Control "no-store"
  </If>

  # Cache : fichiers versionnés 1 an, photos 30 jours, pages toujours fraîches.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpe?g|png|ico|svg)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>
